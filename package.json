{
  "name": "api-rest",
  "version": "0.0.1",
  "description": "Creación de una API REST de Auth con Express, TypeScript, Bun, arquitectura limpia y JWT",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mongoose": "^5.11.97"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "env-var": "^7.5.0",
    "express": "^5.3.0",
    "mongoose": "^9.11.1"
  }
}
